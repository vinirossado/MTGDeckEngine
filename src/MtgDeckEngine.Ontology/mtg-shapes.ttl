@prefix mtg:  <http://example.org/mtg#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

mtg:CardShape a sh:NodeShape ;
    sh:targetClass mtg:Card ;
    sh:property [
        sh:path mtg:hasOracleId ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Card must have a Scryfall oracle ID."
    ] ;
    sh:property [
        sh:path mtg:hasName ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Card must have a name."
    ] .

mtg:DeckShape a sh:NodeShape ;
    sh:targetClass mtg:Deck ;
    sh:property [
        sh:path mtg:hasSource ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A deck must declare its source (edhrec, edhtop16, topdeck, ...)."
    ] .

# Phase 1 used a 99-100 card Commander constraint as the DeckShape. Phase 3
# generalises to multi-format decks (Modern 60+, Legacy 60+, Standard 60+,
# Commander 99 or 100), so format-specific rules are now stored as
# Commander-only / Constructed-only shapes that we can wire in selectively
# when SHACL validation is enabled in the pipeline.

mtg:TournamentEntryShape a sh:NodeShape ;
    sh:targetClass mtg:TournamentEntry ;
    sh:property [
        sh:path mtg:inTournament ;
        sh:minCount 1 ;
        sh:message "Tournament entry must reference a tournament."
    ] ;
    sh:property [
        sh:path mtg:hasDeck ;
        sh:minCount 1 ;
        sh:message "Tournament entry must reference a deck."
    ] ;
    sh:property [
        sh:path mtg:hasPlacement ;
        sh:minCount 1 ;
        sh:datatype xsd:integer ;
        sh:message "Tournament entry must record a placement."
    ] .

mtg:TournamentShape a sh:NodeShape ;
    sh:targetClass mtg:Tournament ;
    sh:property [
        sh:path mtg:hasName ;
        sh:minCount 1 ;
        sh:message "Tournament must have a name."
    ] ;
    # Optional: EDHTop16 publishes no date for ~9% of tournaments (104 of 1,134
    # at the time of writing). A tournament without a date is upstream reality,
    # not corrupt data — so absence is allowed, but a date that IS present must
    # be a real xsd:date.
    sh:property [
        sh:path mtg:hasDate ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:message "Tournament date, when present, must be an xsd:date."
    ] .
