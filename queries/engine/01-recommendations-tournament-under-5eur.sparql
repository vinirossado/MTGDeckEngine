# ===== card-pool =====
# Cards for this commander, with the filters from your request applied.
#
# Prices, images, colours and categories each come back through a
# grouped subquery rather than an inline OPTIONAL: a card carries
# several of each, and joining them inline multiplies the rows so
# LIMIT would keep only a handful of distinct cards.

PREFIX mtg:  <http://example.org/mtg#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

SELECT ?oracleId ?name ?categoryLabel ?inclusion ?synergy ?priceEur ?topCutCount ?wins ?losses ?imageUrl ?typeLine ?colorIdentity ?gameChanger WHERE {
  OPTIONAL {
  GRAPH <http://example.org/mtg#context/xyris-the-writhing-storm> {
    ?card mtg:hasInclusionPct ?inclusion .
    OPTIONAL { ?card mtg:hasSynergyScore ?synergy }
  }
  }
  ?card mtg:hasOracleId ?oracleId ;
        mtg:hasName     ?name ;
        mtg:hasTypeLine ?typeLine .
  OPTIONAL { SELECT ?card (MIN(?e) AS ?eurMin) WHERE { ?card mtg:hasPriceEur ?e } GROUP BY ?card }
  OPTIONAL { SELECT ?card (MIN(?u) AS ?usdMin) WHERE { ?card mtg:hasPriceUsd ?u } GROUP BY ?card }
  BIND (COALESCE(?eurMin, ?usdMin) AS ?priceEur)
  OPTIONAL { SELECT ?card (SAMPLE(?img) AS ?imageUrl) WHERE { ?card mtg:hasImageUrl ?img } GROUP BY ?card }
  OPTIONAL { ?card mtg:isGameChanger ?gameChanger }
  OPTIONAL {
    SELECT ?card (GROUP_CONCAT(DISTINCT ?ci; SEPARATOR=",") AS ?colorIdentity) WHERE {
      ?card mtg:hasColorIdentity ?ciNode .
      BIND (STRAFTER(STR(?ciNode), "color/") AS ?ci)
    } GROUP BY ?card
  }
  OPTIONAL {
    SELECT ?card (GROUP_CONCAT(DISTINCT ?lbl; SEPARATOR=",") AS ?categoryLabel) WHERE {
      GRAPH <http://example.org/mtg#context/xyris-the-writhing-storm> { ?card mtg:inCategory ?cat . OPTIONAL { ?cat rdfs:label ?lbl } }
    } GROUP BY ?card
  }
  {
    SELECT ?card (COUNT(DISTINCT ?deck) AS ?topCutCount)
                 (SUM(?entryWins) AS ?wins) (SUM(?entryLosses) AS ?losses) WHERE {
      ?entry mtg:hasPlacement ?p ; mtg:hasDeck ?deck .
      ?deck  mtg:hasCommander <http://example.org/mtg#commander/xyris-the-writhing-storm> ; mtg:containsCard ?card .
      OPTIONAL { ?entry mtg:hasWinsSwiss     ?ws }
      OPTIONAL { ?entry mtg:hasWinsBracket   ?wb }
      OPTIONAL { ?entry mtg:hasLossesSwiss   ?ls }
      OPTIONAL { ?entry mtg:hasLossesBracket ?lb }
      BIND (COALESCE(?ws, 0) + COALESCE(?wb, 0) AS ?entryWins)
      BIND (COALESCE(?ls, 0) + COALESCE(?lb, 0) AS ?entryLosses)
    } GROUP BY ?card
  }
  FILTER (BOUND(?priceEur) && ?priceEur <= "5"^^xsd:decimal)
  FILTER (BOUND(?inclusion) || BOUND(?topCutCount))
  FILTER (!CONTAINS(?typeLine, "Basic Land"))
}
ORDER BY DESC(?wins) DESC(?topCutCount) DESC(?inclusion)
LIMIT 25
